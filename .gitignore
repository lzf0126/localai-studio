# ============================================================
#  千万不要提交这些 —— 部署目录有 10 GB，模型和后端占了绝大部分
# ============================================================

# Ollama 运行时（约 1.8 GB）
ollama/
lib/ollama/

# 模型权重（每个 0.3–9 GB）
models/
*.gguf
blobs/

# 构建产物（交给 CI 生成，不要进仓库）
dist/
_build/
build/
*.spec
__pycache__/
*.pyc

# 运行时数据（含聊天记录、知识库、个人设置 —— 有隐私）
chats/
logs/
webprofile/
cprofile/
*.log

# 安装包与压缩包
*.zip
*.exe
*.msi
*.7z

# ============================================================
#  绝对不能提交 —— 泄露签名私钥 = 攻击者可以给所有用户推任意程序
# ============================================================
*.pem
*.key
*.pfx
private_key*
signing*
release_key*
*.p12

# 例外：这是 Mozilla 的公共根证书列表，需要随程序分发
!ca-bundle.pem

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp
*~
